{
  "name": "ai-werewolf",
  "version": "1.0.0",
  "main": "index.ts",
  "homepage": "https://cam1-zhang.github.io/ai-werewolf",
  "scripts": {
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "export:web:github": "cross-env EXPO_PUBLIC_BASE_PATH=/${npm_package_name} expo export -p web && node scripts/copy-github-pages-spa-fallback.js",
    "serve:web": "expo serve",
    "room-server": "node server/index.mjs",
    "deploy:github": "npm run export:web:github && gh-pages --nojekyll -d dist",
    "gen:avatars": "tsx scripts/generate-character-avatars.ts",
    "gen:body-portraits": "tsx scripts/generate-character-body-portraits.ts",
    "build:bust-avatars": "tsx scripts/build-bust-avatars-from-body.ts",
    "gen:characters": "npm run gen:body-portraits && npm run build:bust-avatars",
    "build:picker-chibi": "tsx scripts/build-picker-chibi-from-body.ts",
    "gen:picker-chibi": "tsx scripts/generate-picker-chibi-sprites.ts",
    "import:home-brand-logo": "node scripts/import-home-brand-logo.mjs",
    "gen:home-brand-title": "node scripts/gen-home-brand-title.mjs",
    "fix:night-cue-alpha": "node scripts/fix-game-room-night-cue-alpha.mjs",
    "fix:named-alpha": "node scripts/named-body-chroma-to-alpha.mjs",
    "fix:named-alpha:force": "ALLOW_MATTE=1 FORCE=1 node scripts/named-body-chroma-to-alpha.mjs",
    "test:ai-context": "tsx scripts/test-ai-speech-context.ts"
  },
  "dependencies": {
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.3",
    "@react-navigation/native-stack": "^7.14.13",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-av": "~16.0.8",
    "expo-font": "~14.0.11",
    "expo-screen-orientation": "~9.0.9",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "jimp": "^1.6.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
