# LLM provider: dashscope (百炼 Bailian) | ollama | deepseek | siliconflow
# Leave unset or blank → defaults to ollama
EXPO_PUBLIC_LLM_PROVIDER=dashscope

# --- 百炼 / DashScope（推荐：四档难度各绑一个模型）---
# 控制台：https://bailian.console.aliyun.com/ → API Key
EXPO_PUBLIC_DASHSCOPE_API_KEY=
# 也可用别名：
# EXPO_PUBLIC_BAILIAN_API_KEY=

# 默认模型 id（与百炼「模型广场」里名称一致，可按需改）
EXPO_PUBLIC_DASHSCOPE_MODEL_NOVICE=qwen3.6-flash
EXPO_PUBLIC_DASHSCOPE_MODEL_EASY=qwen-plus-2025-07-28
EXPO_PUBLIC_DASHSCOPE_MODEL_MEDIUM=qwen3.7-plus
EXPO_PUBLIC_DASHSCOPE_MODEL_HARD=deepseek-v3.2

# --- Ollama（本地）---
# EXPO_PUBLIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EXPO_PUBLIC_OLLAMA_MODEL=qwen2.5:3b
# 可选：按难度分模型（不设则 Novice–Medium 用 OLLAMA_MODEL，Hard 用 OLLAMA_MODEL_HARD）
# EXPO_PUBLIC_OLLAMA_MODEL_NOVICE=qwen2.5:3b
# EXPO_PUBLIC_OLLAMA_MODEL_EASY=qwen2.5:3b
# EXPO_PUBLIC_OLLAMA_MODEL_MEDIUM=qwen2.5:3b
# EXPO_PUBLIC_OLLAMA_MODEL_HARD=qwen2.5:3b

# --- DeepSeek（可选）---
# EXPO_PUBLIC_DEEPSEEK_API_KEY=

# --- SiliconFlow（可选）---
# EXPO_PUBLIC_SILICONFLOW_API_KEY=

# --- MiniMax 角色语音（前端只填自己的 TTS 服务地址，不要放 MiniMax 密钥）---
# 本地与房间服一起运行时：
# EXPO_PUBLIC_MINIMAX_TTS_URL=http://127.0.0.1:3847
# 以下变量仅配置在服务端环境：
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# MINIMAX_API_BASE_URL=https://api.minimaxi.com
# MINIMAX_TTS_MODEL=speech-01-turbo
# 线上建议限制为游戏网页域名，例如：https://cam1-zhang.github.io
# TTS_ALLOWED_ORIGIN=
